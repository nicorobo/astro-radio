---
import MainLayout from '../layouts/main-layout.astro'
---

<MainLayout title="Schedule | Jetty Radio">
    <h2>Schedule</h2>
    <a
        href="https://calendar.google.com/calendar/ical/88b340766db3ce612b621c05297dc1ba9ae71e04a67a22a9b749dda336c878f3%40group.calendar.google.com/public/basic.ics"
        target="_blank">Add to your calendar</a
    >
    <iframe
        class="embedded-calendar"
        src="https://calendar.google.com/calendar/embed?height=500&wkst=1&ctz=America%2FLos_Angeles&showPrint=0&showTitle=0&mode=AGENDA&showTabs=0&showCalendars=0&showNav=0&src=ODhiMzQwNzY2ZGIzY2U2MTJiNjIxYzA1Mjk3ZGMxYmE5YWU3MWUwNGE2N2EyMmE5Yjc0OWRkYTMzNmM4NzhmM0Bncm91cC5jYWxlbmRhci5nb29nbGUuY29t&color=%23f4511e"
        frameborder="0"
        scrolling="no"></iframe>
    <p>
        <small>First Tuesday 6-7pm</small><br />
        MXO Radio w/ MIMIXOMI<br />
    </p>
    <hr style="width:100%" />
    <p>
        <small>First Friday 4-5pm</small><br />
        <img
            src="https://stream.jettyradio.com/api/station/jettyradio/art/10e132d18ccd2cc7279ca29c-1767563637.jpg"
            width="100"
        /><br />
        Afternoon Cruise w/ <a
            href="https://www.instagram.com/leeanyewade/"
            target="_blank">Goose</a
        ><br />
    </p>
    <hr style="width:100%" />
    <p>
        <small>Second Thursday 7-8pm</small><br />
        <img
            src="https://stream.jettyradio.com/api/station/1/art/105"
            style="width: 100px"
        /><br />
        forgetting my manners w/ <a
            href="https://www.instagram.com/rikvinegar/"
            target="_blank">r.downstairs</a
        ><br />
    </p>
    <hr style="width:100%" />
    <p>
        <small>Third Saturday 2-3pm</small><br />
        <img
            src="https://stream.jettyradio.com/api/station/jettyradio/art/6d3916a3b3d5b91d1616ee77-1766251640.jpg"
            style="width: 100px"
        /><br />
        {'{On Location}'} Dubs w/ <a
            href="https://www.instagram.com/reverb.canopy/"
            target="_blank">DJ Tschona</a
        ><br />
    </p>
    <p>
        <a href="/">Home</a>
    </p>
</MainLayout>
